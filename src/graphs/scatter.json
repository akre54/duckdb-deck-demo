{
  "name": "scatter — clustered points, log radius, elevation color",
  "params": {
    "speedCutoff": { "value": 0, "min": 0, "max": 120, "step": 1, "kind": "value", "label": "speed cutoff" },
    "sizeScale": { "value": 1.6, "min": 0.2, "max": 12, "step": 0.1, "kind": "value", "label": "size scale" },
    "elevExag": { "value": 0.4, "min": 0, "max": 3, "step": 0.01, "kind": "value", "label": "elevation exaggeration" },
    "colorFloor": { "value": 0, "min": 0, "max": 900, "step": 5, "kind": "value", "label": "color domain floor" }
  },
  "nodes": [
    {
      "id": "src",
      "type": "source",
      "dataset": { "kind": "synthetic", "rows": 300000 }
    },
    {
      "id": "fast",
      "type": "filter",
      "input": "src",
      "predicate": "speed > {{speedCutoff}}"
    },
    {
      "id": "popStats",
      "type": "stats",
      "input": "fast",
      "column": "pop",
      "ops": ["min", "max", "p99"]
    },
    {
      "id": "proj",
      "type": "project",
      "input": "fast",
      "mode": "mercator",
      "x": "lng",
      "y": "lat",
      "z": "elevation * {{elevExag}} * 0.0006",
      "worldScale": "1.0"
    },
    {
      "id": "radius",
      "type": "scale",
      "input": "proj",
      "name": "pscale",
      "expr": "pop",
      "kind": "log",
      "domain": "auto",
      "statsFrom": "popStats",
      "range": ["{{sizeScale}} * 0.4", "{{sizeScale}} * 3.5"]
    },
    {
      "id": "color",
      "type": "colorscale",
      "input": "radius",
      "expr": "elevation",
      "ramp": "viridis",
      "domain": ["{{colorFloor}}", "900"]
    },
    {
      "id": "out",
      "type": "render",
      "input": "color",
      "mode": "points",
      "position": "P",
      "color": "Cd",
      "size": "pscale",
      "background": [0.035, 0.039, 0.055]
    }
  ]
}
