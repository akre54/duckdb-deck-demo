{
  "name": "duckdb-webgpu-graph-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "PoC: DuckDB Arrow -> JSON graph planner -> WebGPU. Houdini-style attributes, no deck.gl in the critical path.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "apache-arrow": "^17.0.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.49",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
