{
  "name": "wrangle \u2014 one VEX-style body instead of four operator nodes",
  "params": {
    "speedCutoff": {
      "value": 0,
      "min": 0,
      "max": 120,
      "step": 1,
      "kind": "value",
      "changeRate": 0.2,
      "label": "speed cutoff"
    },
    "sizeScale": {
      "value": 1.6,
      "min": 0.2,
      "max": 12,
      "step": 0.1,
      "kind": "value",
      "changeRate": 8,
      "label": "size scale (dragged)"
    },
    "exag": {
      "value": 0.4,
      "min": 0,
      "max": 3,
      "step": 0.01,
      "kind": "value",
      "changeRate": 8,
      "label": "elevation exaggeration (dragged)"
    },
    "lo": {
      "value": 2.3,
      "min": 0,
      "max": 14,
      "step": 0.1,
      "kind": "value",
      "changeRate": 1,
      "label": "population domain lo"
    },
    "hi": {
      "value": 13.9,
      "min": 0,
      "max": 14,
      "step": 0.1,
      "kind": "value",
      "changeRate": 1,
      "label": "population domain hi"
    }
  },
  "nodes": [
    {
      "id": "src",
      "type": "source",
      "dataset": {
        "ref": "synthetic",
        "rows": 300000,
        "estimatedRows": 300000
      }
    },
    {
      "id": "fast",
      "type": "filter",
      "input": "src",
      "predicate": "speed > {{speedCutoff}}"
    },
    {
      "id": "wr",
      "type": "wrangle",
      "input": "fast",
      "ramp": "turbo",
      "body": "// Web Mercator, normalized so the whole world fits in one world unit.\n@P = [lng / 360.0, ln(tan(0.7853981634 + lat * 0.008726646259971648)) / 6.283185307, elevation * {{exag}} * 0.0006];\n\n// A local: computed once, read by both statements below it.\nvar t = clamp(fit(ln(pop), {{lo}}, {{hi}}, 0.0, 1.0), 0.0, 1.0);\n\n@Cd = ramp(t);\n@pscale = ({{sizeScale}} * 0.4) + t * ({{sizeScale}} * 3.1);\n"
    },
    {
      "id": "out",
      "type": "render",
      "input": "wr",
      "mode": "points",
      "position": "P",
      "color": "Cd",
      "size": "pscale",
      "background": [
        0.03,
        0.032,
        0.045
      ]
    }
  ]
}
