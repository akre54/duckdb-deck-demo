{
  "name": "@noodles.gl/graph-view",
  "version": "0.1.0",
  "type": "module",
  "description": "A JSON description of a node graph, and a viewer for it. Producer-agnostic: a GPU command graph, a query plan or an editor network all describe themselves the same way.",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
